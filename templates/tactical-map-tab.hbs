<div class="tab" data-group="main" data-tab="tacticalMap">
  <div class="form-group">
    <label>Tactical Map Image</label>
    <div class="form-fields">
      <input type="text" name="tacticalMapImage" value="{{tacticalMapImage}}" placeholder="path/to/tactical/map/image">
      <button type="button" class="tacticalmap-filepicker file-picker" data-type="image" data-target="input[name='tacticalMapImage']" title="Browse Files">
        <i class="fas fa-file-import"></i>
      </button>
    </div>
    <p class="notes">Map image to be used during tactical combat in the scene.</p>
  </div>

  <div class="form-group">
    <label>Tactical Map Type</label>
    <div class="form-fields">
      <select name="tacticalMapType">
        <option value="top-down" {{#if isTopDown}}selected{{/if}}>Top-down</option>
        <option value="isometric" {{#if isIsometric}}selected{{/if}}>Isometric View</option>
      </select>
    </div>
    <p class="notes">Token type to use: "token_tdv" to Top-down and "token_isv" to Isometric.</p>
  </div>

  <hr>
  
  <div class="form-group">
    <label><i class="fas fa-swords"></i> Auto Add Tokens to Encounter</label>
    <div class="form-fields">
      <input type="checkbox" name="addTokensToEncounter" {{#if addTokensToEncounter}}checked{{/if}}>
    </div>
    <p class="notes">Automatically add all tokens to a combat encounter when switching to the tactical map.</p>
  </div>

  <hr>

  <div class="tm-title3">Tactical Map Grid Settings:</div>
  {{#unless hasTacticalMap}}
  <p class="notes">Set the grid type and blur amount. Add a tactical map image to access other grid settings.</p>
  {{/unless}}

  <div class="grid-settings-container">
    <div class="form-group">
      <label>Grid Type</label>
      <div class="form-fields">
        <select name="tacticalMapGridType">
          {{#each gridTypeOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.text}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    

    <div class="form-group"
     {{#if hasTacticalMap}} style="display: none;"{{/if}}>
      <label>Background Blur</label>
      <div class="form-fields">
        <input type="range" name="blurAmount" value="{{blurAmount}}" min="0" max="30" step="1">
        <span class="range-value">{{blurAmount}}</span>
      </div>
      <p class="notes">Blur when no tactical map image is set.</p>
    </div>
  </div>


  <hr>

  {{#if hasTacticalMap}}
    <div class="grid-settings-container">
      <div>
        <div class="form-group">
          <label>Grid Size <span class="units"></span></label>
          <div class="form-fields">
            <input type="number" name="tacticalMapGridSize" value="{{tacticalGridSize}}" min="20" step="1" placeholder="Pixels">
          </div>
        </div>

        <div class="form-group">
          <label>Grid Scale</label>
          <div class="form-fields">
            <label class="grid-label">Distance</label>
            <input type="number" name="tacticalMapGridScale.distance" value="{{tacticalGridScale.distance}}" step="any" placeholder="1">
            <label class="grid-label">Units</label>
            <input type="text" name="tacticalMapGridScale.units" placeholder="None" value="{{tacticalGridScale.units}}">
          </div>
        </div>

        <div class="form-group">
          <label>Grid Style</label>
          <div class="form-fields">
            <select name="tacticalMapGridStyle">
              {{#each gridStyleOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.text}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>
      <div>
        <div class="form-group">
          <label>Grid Thickness</label>
          <div class="form-fields">
            <input type="number" name="tacticalMapGridThickness" value="{{tacticalGridThickness}}" step="any" placeholder="1">
          </div>
        </div>

        <div class="form-group">
          <label>Grid Color</label>
          <div class="form-fields">
            <input type="text" name="tacticalMapGridColor" value="{{tacticalGridColor}}" placeholder="#000000">
            <input type="color" value="{{tacticalGridColor}}" data-edit="tacticalMapGridColor">
          </div>
        </div>

        <div class="form-group">
          <label>Grid Opacity</label>
          <div class="form-fields">
            <input type="range" name="tacticalMapGridAlpha" value="{{tacticalGridAlpha}}" min="0" max="1" step="0.05">
            <span class="range-value">{{tacticalGridAlpha}}</span>
          </div>
        </div>
      </div>
    </div>

    <hr>
  
    <div class="form-group">
      <label>Preview:</label>
      <div class="preview-image">
        <img src="{{tacticalMapImage}}" style="max-width: 250px; max-height: 200px; object-fit: contain;">
      </div>
    </div>
  {{/if}}
</div>